cat > .gitignore << 'EOF'
# Fichiers compiles
*.class
PuzzleIA/puzzle/*.class

# Archives
*.zip
*.rar
*.7z
*.tar.gz

# Fichiers temporaires
*.log
*.tmp
*.bak

# Dossiers systeme
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.iml
.classpath
.project
.settings/

# Fichiers volumineux
PuzzleIA/opencv/
EOF